# Optional: docker compose --env-file docker/.env -f docker/docker-compose.yaml up -d --build
FNS_DATA_DIR=/data/fast-note-sync
FNS_PUBLIC_PORT=9000
# Public HTTPS origin for the home-page canonical URL; omit in local testing.
# FNS_SITE_URL=https://notes.example.com
# HTTPS: true; direct HTTP testing: false
FNS_SESSION_SECURE=true
FNS_WEB_FRONTEND_ENABLED=true
# Normally omit this: the container generates config/.web-session-key automatically.
# FNS_SESSION_PASSWORD=
