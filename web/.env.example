FNS_SESSION_PASSWORD=
# false for local HTTP only; use true for production HTTPS
FNS_SESSION_SECURE=false
FNS_SESSION_DIR=./.sessions
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
